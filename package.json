{
  "name": "@munin-media/core",
  "version": "1.0.1",
  "description": "Zero-knowledge media memory service — progress tracking, ratings, and recommendations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.js"
    },
    "./firestore": {
      "types": "./dist/firestore.d.ts",
      "import": "./dist/firestore.js",
      "require": "./dist/firestore.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./mmdb": {
      "types": "./dist/adapters/mmdb.d.ts",
      "import": "./dist/adapters/mmdb.js",
      "require": "./dist/adapters/mmdb.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.28.0",
    "firebase-admin": "^12.0.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.28.0",
    "firebase-admin": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.4.0",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/munin-media/munin-core.git"
  }
}
